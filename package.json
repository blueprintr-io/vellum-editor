{
  "name": "vellum-editor",
  "version": "1.7.5",
  "private": true,
  "description": "A diagram editor with freehand drawing and structured shapes.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Josh Morris",
  "homepage": "https://github.com/blueprintr-io/vellum-editor",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blueprintr-io/vellum-editor"
  },
  "bugs": {
    "url": "https://github.com/blueprintr-io/vellum-editor/issues"
  },
  "keywords": [
    "diagram",
    "editor",
    "draw",
    "svg",
    "react",
    "vite"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles/globals.css"
  },
  "files": [
    "src",
    "scripts/sync-iconpacks.mjs",
    "legal",
    "tsconfig.json",
    "tailwind.config.ts",
    "postcss.config.js",
    "vite.config.ts",
    "index.html",
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "//scripts": "The standalone web build can include optional local icon packs. build:public and build:desktop-web use tracked public assets and exclude vendor packs. Native builds use build:desktop-web.",
  "scripts": {
    "dev": "node scripts/sync-iconpacks.mjs && vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:version": "node scripts/version-sync.mjs --check",
    "test": "node --test --import tsx tests/*.test.ts",
    "test:e2e": "playwright test",
    "sync:icons": "node scripts/sync-iconpacks.mjs",
    "prebuild": "node scripts/sync-iconpacks.mjs",
    "dev:web": "vite",
    "build:desktop-web": "node scripts/build-public.mjs --desktop",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target aarch64-apple-darwin",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "release": "node scripts/release.mjs",
    "build:public": "node scripts/build-public.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "notices": "node scripts/dependency-notices.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource/architects-daughter": "^5.2.7",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/patrick-hand": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "dompurify": "^3.4.15",
    "gifenc": "^1.0.3",
    "yaml": "^2.6.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.1",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^28.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.28",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
